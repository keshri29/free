# Copy this file to .env.local for local dev, and set the same keys in
# your Vercel project settings (Production + Preview) for deployment.

# Your real production domain, no trailing slash. Backs canonical URLs,
# sitemap.xml, robots.txt and all JSON-LD. Required for correct SEO.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Medium username to sync (the part after the @ in your profile URL).
MEDIUM_USERNAME=keshrianurag690

# Vercel KV (Upstash Redis) — create a KV store in the Vercel dashboard and
# link it to this project; it will inject these two automatically. Without
# them, the blog system falls back to an in-memory store that resets on
# every restart/deploy (fine for local dev, not for production).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret for the Medium sync cron job (/api/blogs/sync). Set this in
# Vercel's project env vars — Vercel automatically sends it as
# `Authorization: Bearer <value>` when it triggers the cron in vercel.json.
CRON_SECRET=
